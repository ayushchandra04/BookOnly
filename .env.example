# MongoDB Atlas connection string (must be a replica set — free M0 tier qualifies —
# because seat-hold and waitlist logic rely on multi-document transactions)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ticket-booking?retryWrites=true&w=majority

# Secret used to sign auth JWTs. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# Secret required as a Bearer token on GET/POST /api/cron/sweep so it can't be
# triggered by anyone who finds the URL. Generate the same way as JWT_SECRET.
CRON_SECRET=replace-with-a-long-random-string

# Public base URL of the deployed app, used to build links in emails
# (waitlist offer accept link, etc). No trailing slash.
APP_BASE_URL=http://localhost:3000

# Gmail SMTP credentials for sending booking confirmation / waitlist offer emails.
# GMAIL_USER is the full gmail address. GMAIL_APP_PASSWORD is a 16-character
# App Password generated at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the account) — NOT your normal Gmail password.
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Seat hold time-to-live, in minutes
SEAT_HOLD_TTL_MINUTES=10

# Waitlist offer time-to-live, in minutes
WAITLIST_OFFER_TTL_MINUTES=15
